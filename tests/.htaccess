# Die Funktionstests gehoeren nicht ins Web. Das Wurzelverzeichnis sperrt sie schon
# ueber RedirectMatch; diese Datei ist die zweite Schicht und greift auch dann,
# wenn eine Regel dort einmal umgeschrieben wird.
#
# Sie greift NICHT, wenn ein vorgelagerter Server statische Dateien selbst
# ausliefert. In Plesk ist das die Voreinstellung "Smart static files
# processing" von nginx: .html, .css, .js und Bilder gehen dann nie durch
# Apache, und keine .htaccess der Welt wird dabei gelesen. Woran man es
# erkennt, steht im Befund von check.html; die Abhilfe im README unter
# "Vorgelagerter nginx".

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
